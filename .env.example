# Copy to .env and fill in, or just export these in your shell.
# .env is gitignored — never commit real keys.

# Required. One key covers both the art-direction model and GPT Image 2.
# Get one at https://kie.ai/api-key
KIE_API_KEY=

# Optional overrides. Defaults are set in thumbnail_picker/config.py.
# KIE_CHAT_MODEL=gpt-5-2
# KIE_IMAGE_MODEL=gpt-image-2-image-to-image

# Optional. If set, the video's speech is transcribed with OpenAI Whisper so the
# headline can quote what is actually said. Costs ~$0.006 per minute of audio.
# OPENAI_API_KEY=

# Optional. Absolute path to a heavy sans-serif .ttf for the headline. Only needed
# if none of the system fonts in config.FONT_CANDIDATES exist on your machine.
# THUMBNAIL_FONT_PATH=
