# Copy this file to .env and fill in the key, or just export the variables in your shell.
# Real environment variables always win over anything in .env.
# .env is gitignored — never commit real keys.

# Required. One key covers both the art-direction model and GPT Image 2.
# Get one at https://kie.ai/api-key
KIE_API_KEY=

# Optional overrides. Defaults are set in thumbnail_picker/config.py.
# KIE_CHAT_MODEL=gpt-5-2
# KIE_IMAGE_MODEL=gpt-image-2-image-to-image

# What each render costs. GPT Image 2 has no quality parameter — resolution is the
# only cost lever: 1K = 6 credits ($0.03), 2K = 10 ($0.05), 4K = 16 ($0.08).
# 1K already exceeds the 1280x720 export, so 2K/4K only help if you raise OUTPUT_WIDTH.
# KIE_IMAGE_RESOLUTION=1K

# Optional. If set, the video's speech is transcribed with OpenAI Whisper so the
# headline can quote what is actually said. Costs ~$0.006 per minute of audio.
# OPENAI_API_KEY=

# Optional. Absolute path to a heavy sans-serif .ttf for the headline. Anton ships in
# fonts/, so this is only needed to use a different brand typeface.
# THUMBNAIL_FONT_PATH=

# Optional, and only relevant to the YouTube link tab.
#
# YouTube bot-gates datacenter IPs: the same link that downloads fine from a laptop is
# refused on a cloud server, whatever yt-dlp version or player client is used. The Upload
# tab is unaffected because it never touches YouTube.
#
# Cookies exported from a logged-in browser in Netscape format. They work, but expire
# after days or weeks, and Google may flag an account whose cookies show up from a server
# in another country. Use a throwaway account, never your main one.
# YTDLP_COOKIES_FILE=/home/admin/thumbsmith/cookies.txt
#
# A residential or rotating proxy. Costs money, but it is the option that keeps working
# without anyone having to re-export cookies.
# YTDLP_PROXY=http://user:pass@host:port
